{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Knowledge",
  "version": "0.1.0",
  "identifier": "com.knowledgeapp.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Knowledge",
        "width": 520,
        "height": 640,
        "minWidth": 420,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "transparent": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Education",
    "shortDescription": "Daily engineering learning + local-LLM repo Q&A",
    "longDescription": "A daily popup that grows senior/staff/principal engineers with multiple-choice challenges, plus local-LLM question answering over your linked GitHub repositories. All inference runs locally via Ollama."
  },
  "plugins": {}
}
